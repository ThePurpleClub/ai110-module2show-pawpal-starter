classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet Pet) void
        +get_all_tasks() List~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +List~Task~ tasks
        +add_task(task Task) void
        +remove_task(task Task) void
    }

    class Task {
        +str description
        +int duration_minutes
        +str priority
        +str time
        +str frequency
        +bool completed
        +str pet_name
        +mark_complete() void
    }

    class Scheduler {
        +Owner owner
        +List~Task~ plan
        +List~Tuple~ skipped
        +generate_plan() List~Task~
        +sort_by_priority(tasks List~Task~) List~Task~
        +fits_in_time(task Task, remaining int) bool
        +explain_plan() str
    }

    Owner "1" o-- "1..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : plans for
    Scheduler ..> Task : orders and selects
